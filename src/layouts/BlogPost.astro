---
import type { MarkdownHeading } from "astro";
import Paginator from "@/components/Paginator";
import { getLocaleTime, postUrl, tagUrl } from "src/util";
import type { Post } from "src/util";
import BaseLayout from "./Base.astro";
import SocialList from "@/components/SocialList";

export interface Props {
	post: Post;
	headings: MarkdownHeading[];
	prev: Post | null;
	next: Post | null;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const headings = Astro.props.headings.filter((heading) => heading.depth < 3);
const datetime = pubDate.toISOString();
const postDate = getLocaleTime(pubDate);

const paginationProps = {
	...(prev && {
		prevUrl: {
			url: postUrl(prev),
			text: `← ${prev.data.title}`,
			srLabel: "Previous Article:",
		},
	}),
	...(next && {
		nextUrl: {
			url: postUrl(next),
			text: `${next.data.title} →`,
			srLabel: "Next Article:",
		},
	}),
};
---

<BaseLayout meta={{ title, description, pubDate: postDate }}>
	<div class="sm:grid sm:grid-cols-[1fr_13rem] sm:items-start sm:gap-x-10">
		<article>
			<time
				datetime={datetime}
				class="text-xs text-surface-content/55 tabular-nums"
			>
				{postDate}
			</time>
			<h1 class="mt-2 text-3xl leading-tight font-bold text-surface-content">
				{title}
			</h1>
			<p class="mt-3 text-sm leading-relaxed text-surface-content/70">
				<span class="text-secondary/70">// </span>{description}
			</p>
			{
				headings.length > 0 && (
					<details class="mt-8 rounded-md border border-border bg-surface-raised px-4 py-3 sm:hidden">
						<summary class="section-label cursor-pointer select-none">
							On this page
						</summary>
						<ul class="mt-3 space-y-2 text-xs">
							{headings.map(({ slug, text }) => (
								<li>
									<a
										href={`#${slug}`}
										class="text-surface-content/70 transition-colors duration-200 hover:text-primary"
									>
										{text}
									</a>
								</li>
							))}
						</ul>
					</details>
				)
			}
			<div
				class="prose mt-10 max-w-none prose-headings:font-semibold prose-strong:text-surface-content"
			>
				<slot />
				<div class="mt-2 flex flex-col pt-2">
					<h3>Thanks for reading! 🫶</h3>
					<p>
						I would love to hear your thoughts on this. If you have any
						questions or comments, please feel free to reach out on any of the
						platforms below. I look forward to connecting with you!
					</p>
					<div class="flex items-center gap-x-2">
						Reach out on: <SocialList rss={false} github={false} />
					</div>
				</div>
				<div class="flex items-center justify-end pt-10 text-xs">
					<a
						href={`https://github.com/RatulMaharaj/ratulmaharaj.com/edit/main/src/content/posts/${post.id}.md`}
						>Edit this page</a
					>
				</div>
			</div>
		</article>
		{
			headings.length > 0 && (
				<aside class="hidden sm:sticky sm:top-16 sm:block">
					<h2 class="section-label">On this page</h2>
					<ul class="mt-4 space-y-2 text-xs">
						{headings.map(({ slug, text }) => (
							<li class="line-clamp-2">
								<a
									href={`#${slug}`}
									data-toc-link={slug}
									class="text-surface-content/60 transition-colors duration-200 hover:text-primary"
									aria-label={`Scroll to section: ${text}`}
								>
									{text}
								</a>
							</li>
						))}
					</ul>
				</aside>
			)
		}
	</div>
	<div class="mt-12">
		{
			tags?.length && (
				<ul class="flex flex-wrap items-center gap-x-4 gap-y-2 py-4">
					{tags.map((tag: string) => (
						<li>
							<a
								class="tag"
								aria-label={`View more blogs with the tag ${tag}`}
								href={tagUrl(tag)}
							>
								#{tag}
							</a>
						</li>
					))}
				</ul>
			)
		}
		<Paginator {...paginationProps} />
	</div>
</BaseLayout>

<script>
	// TOC scroll-spy: highlight the last section heading above the reading line
	const tocLinks =
		document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
	const headings = Array.from(
		document.querySelectorAll<HTMLElement>("article :is(h1, h2)[id]"),
	);
	if (tocLinks.length > 0 && headings.length > 0) {
		const setActive = (slug: string) => {
			tocLinks.forEach((link) => {
				const isActive = link.dataset.tocLink === slug;
				link.classList.toggle("text-primary", isActive);
				link.classList.toggle("text-surface-content/60", !isActive);
				if (isActive) {
					link.setAttribute("aria-current", "true");
				} else {
					link.removeAttribute("aria-current");
				}
			});
		};
		let ticking = false;
		const update = () => {
			ticking = false;
			const line = window.innerHeight * 0.3;
			const current =
				headings.filter((h) => h.getBoundingClientRect().top <= line).pop() ??
				headings[0];
			setActive(current.id);
		};
		document.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		update();
	}
</script>

<style>
	/* Hide the weird code block adding the language */
	:global(article pre .language-id) {
		display: none;
	}
</style>
