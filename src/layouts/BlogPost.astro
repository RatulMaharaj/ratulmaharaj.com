---
import type { MarkdownHeading } from "astro";
import Paginator from "@/components/Paginator";
import { getLocaleTime, postUrl, tagUrl } from "src/util";
import type { Post } from "src/util";
import BaseLayout from "./Base.astro";
import SocialList from "@/components/SocialList";

export interface Props {
	post: Post;
	headings: MarkdownHeading[];
	prev: Post | null;
	next: Post | null;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const headings = Astro.props.headings.filter((heading) => heading.depth < 3);
const datetime = pubDate.toISOString();
const postDate = getLocaleTime(pubDate);

const paginationProps = {
	...(prev && {
		prevUrl: {
			url: postUrl(prev),
			text: `← ${prev.data.title}`,
			srLabel: "Previous Article:",
		},
	}),
	...(next && {
		nextUrl: {
			url: postUrl(next),
			text: `${next.data.title} →`,
			srLabel: "Next Article:",
		},
	}),
};
---

<BaseLayout meta={{ title, description, pubDate: postDate }}>
	<div class="sm:grid sm:grid-cols-[3fr_1fr] sm:items-start sm:gap-x-10">
		<article>
			<div class="mb-2">
				<time datetime={datetime} class="text-xs text-surface-content/50">
					{postDate}
				</time>
			</div>
			<h1
				class="mb-1 flex items-start justify-start text-2xl font-bold text-surface-content"
			>
				{title}
			</h1>
			<p class="line-clamp-3 block text-sm text-surface-content/80 italic">
				// {description}
			</p>
			<br />
			<br />
			<div
				class="prose prose-sm w-full max-w-full prose-headings:font-semibold prose-strong:text-surface-content"
			>
				<slot />
				<div class="mt-2 flex flex-col pt-2">
					<h3>Thanks for reading! 🫶</h3>
					<p>
						I would love to hear your thoughts on this. If you have any
						questions or comments, please feel free to reach out on any of the
						platforms below. I look forward to connecting with you!
					</p>
					<div class="flex items-center gap-x-2">
						Reach out on: <SocialList rss={false} github={false} />
					</div>
				</div>
				<div class="flex items-center justify-end pt-10 text-xs">
					<a
						href={`https://github.com/RatulMaharaj/ratulmaharaj.com/edit/main/src/content/posts/${post.id}.md`}
						>Edit this page</a
					>
				</div>
			</div>
		</article>
		<aside
			class="invisible hidden text-right sm:visible sm:sticky sm:top-20 sm:block"
		>
			<h2 class="font-semibold">Table of Contents</h2>
			<ul class="mt-4 space-y-2 text-xs">
				{
					headings.map(({ slug, text }) => (
						<li class="line-clamp-2 hover:text-primary">
							<a href={`#${slug}`} aria-label={`Scroll to section: ${text}`}>
								{text}
							</a>
						</li>
					))
				}
			</ul>
		</aside>
	</div>
	<div class="mt-10">
		{
			tags?.length && (
				<ul class="flex flex-wrap items-center gap-y-2 py-4">
					{tags.map((tag: string) => (
						<li>
							<a
								class="category-tag"
								aria-label={`View more blogs with the tag ${tag}`}
								href={tagUrl(tag)}
							>
								{tag}
							</a>
						</li>
					))}
				</ul>
			)
		}
		<Paginator {...paginationProps} />
	</div>
</BaseLayout>

<style>
	/* Hide the weird code block adding the language */
	:global(article pre .language-id) {
		display: none;
	}
</style>
