---
import type { MarkdownHeading } from "astro";
import Paginator from "@/components/Paginator";
import { getLocaleTime, postUrl, tagUrl } from "src/util";
import type { Post } from "src/util";
import BaseLayout from "./Base.astro";
import SocialList from "@/components/SocialList";

export interface Props {
	post: Post;
	headings: MarkdownHeading[];
	prev: Post | null;
	next: Post | null;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const datetime = pubDate.toISOString();
const postDate = getLocaleTime(pubDate);

// Point edit links at the branch this deploy was built from, so they
// resolve on previews too (posts moved paths in the collections migration).
const editBranch = process.env.VERCEL_GIT_COMMIT_REF ?? "main";
const editUrl = `https://github.com/RatulMaharaj/ratulmaharaj.com/edit/${editBranch}/src/content/posts/${post.id}.md`;

const paginationProps = {
	...(prev && {
		prevUrl: {
			url: postUrl(prev),
			text: `← ${prev.data.title}`,
			srLabel: "Previous Article:",
		},
	}),
	...(next && {
		nextUrl: {
			url: postUrl(next),
			text: `${next.data.title} →`,
			srLabel: "Next Article:",
		},
	}),
};
---

<BaseLayout meta={{ title, description, pubDate: postDate }}>
	<!-- The page as the editor draws it: one centered column at the measure,
	     nothing beside the document. -->
	<!-- The measure is 70ch of the reading face, as the editor computes it,
	     so the column sets its font before its width. -->
	<article
		class="mx-auto w-full font-sans"
		style="max-width: 70ch; font-size: 16px"
	>
		<!-- Metadata in the ledger voice, set on one line at the head of the
		     document so the reader gets date and tags in a glance, then the title. -->
		<div
			class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-[11.5px] leading-[1.65] tracking-[0.02em]"
			style="color: var(--ink-3)"
		>
			<time datetime={datetime} class="tabular-nums">{postDate}</time>
			{
				tags?.length && (
					<Fragment>
						<span aria-hidden="true" style="opacity: 0.5">
							·
						</span>
						<div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
							{tags.map((tag: string) => (
								<a
									class="badge"
									aria-label={`View more blogs with the tag ${tag}`}
									href={tagUrl(tag)}
								>
									{tag}
								</a>
							))}
						</div>
					</Fragment>
				)
			}
		</div>
		<div class="prose w-full">
			<h1>{title}</h1>
			<p style="color: var(--ink-2)">{description}</p>
			<slot />
		</div>
		<footer
			class="prose mt-14 w-full border-t pt-5"
			style="border-color: var(--rule)"
		>
			<p><strong>Thanks for reading! 🫶</strong></p>
			<p style="color: var(--ink-2)">
				I would love to hear your thoughts on this. If you have any questions or
				comments, please feel free to reach out on any of the platforms below. I
				look forward to connecting with you!
			</p>
			<div class="mt-3 flex items-center gap-x-4">
				<span class="section-label">reach out on</span>
				<SocialList rss={false} github={false} />
			</div>
			<div class="mt-6 flex justify-end">
				<a class="ledger-link" href={editUrl}> edit this page &rarr; </a>
			</div>
		</footer>
		<div class="mt-10">
			<Paginator {...paginationProps} />
		</div>
	</article>
</BaseLayout>

<style>
	/* Hide the weird code block adding the language */
	:global(article pre .language-id) {
		display: none;
	}
</style>
