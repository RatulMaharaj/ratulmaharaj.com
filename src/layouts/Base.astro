---
import BaseHead from "@/components/BaseHead";
import Footer from "@/components/Footer";
import Header from "@/components/Header";
import SkipLink from "@/components/SkipLink";
import type { SiteMeta } from "@/types";
import siteMeta from "src/site-meta.config";
import PostHog from "@/components/PostHog";
import Palette from "@/components/Palette";
import { asciiBanner } from "src/ascii-banner";

export type Props = {
	meta: SiteMeta;
};

const {
	meta: { title, description, pubDate, image },
} = Astro.props as Props;
---

<html lang={siteMeta.lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			pubDate={pubDate}
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Ratul's Blog"
			href={`${Astro.site}rss.xml`}
		/>
		<script define:vars={{ siteMeta }}>
			// Three papers, in the manner of an e-reader's Aa menu: day, sepia,
			// night. Night doubles as Tailwind's `.dark`; the others are light
			// schemes told apart by data-theme.
			const root = document.documentElement;
			const colorThemeMetaTag = document.querySelector(
				"meta[name='theme-color']",
			);
			const metaColors = {
				day: siteMeta.themeColorLight,
				sepia: siteMeta.themeColorSepia,
				night: siteMeta.themeColorDark,
			};
			window.__applyTheme = (theme, persist = true) => {
				root.dataset.theme = theme;
				root.classList.toggle("dark", theme === "night");
				colorThemeMetaTag.setAttribute("content", metaColors[theme]);
				if (persist) localStorage.setItem("theme", theme);
				document.dispatchEvent(
					new CustomEvent("themechange", { detail: theme }),
				);
			};
			let theme =
				typeof localStorage !== "undefined"
					? localStorage.getItem("theme")
					: null;
			// Legacy values from the two-theme days.
			if (theme === "light") theme = "day";
			if (theme === "dark") theme = "night";
			const stored = ["day", "sepia", "night"].includes(theme);
			if (!stored)
				theme = window.matchMedia("(prefers-color-scheme: dark)").matches
					? "night"
					: "day";
			window.__applyTheme(theme, stored);
		</script>

		<script>
			// get code blocks
			const codeBlocks = document.querySelectorAll<HTMLElement>("pre code");

			// loop through code blocks
			codeBlocks.forEach((block) => {
				// Add copy to clipboard button
				const button = document.createElement("button");
				button.className = "copy";
				button.innerText = "copy";
				button.setAttribute("aria-label", "Copy code to clipboard");
				block.parentNode?.appendChild(button);

				// Add copy to clipboard functionality using navigator.clipboard
				button.addEventListener("click", () => {
					navigator.clipboard.writeText(block.innerText).then(() => {
						button.innerText = "copied";
						setTimeout(() => {
							button.innerText = "copy";
						}, 2000);
					});
				});
			});
		</script>
	</head>
	<body>
		<Fragment set:html={asciiBanner} />
		<SkipLink />
		<Header />
		<main id="main" class="flex-1 pt-10">
			<slot />
		</main>
		<Footer />
		<Palette />
		<slot name="rss-writer" />
		<PostHog />
		{/* agent-comments: ⌘+right-click any element to leave feedback for the AI agent (dev only) */}
		{import.meta.env.DEV && <agent-comments collapsed />}
		<script>
			if (import.meta.env.DEV) import("agent-comments");
		</script>
	</body>
</html>
