---
import type { PaginationLink } from "@/types";

export interface Props {
	prevUrl?: PaginationLink;
	nextUrl?: PaginationLink;
}

const { prevUrl, nextUrl } = Astro.props as Props;
---

{
	(prevUrl || nextUrl) && (
		<nav class="mt-5 flex items-center gap-x-4">
			{prevUrl && (
				<a
					class="py-2 text-xs text-surface-content/55 transition-colors duration-200 hover:text-primary"
					href={prevUrl.url}
				>
					{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}
					{prevUrl.text ? prevUrl.text : "Previous"}
				</a>
			)}
			{nextUrl && (
				<a
					class="ml-auto py-2 text-xs text-surface-content/55 transition-colors duration-200 hover:text-primary"
					href={nextUrl.url}
				>
					{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}
					{nextUrl.text ? nextUrl.text : "Next"}
				</a>
			)}
		</nav>
	)
}
