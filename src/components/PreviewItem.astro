---
import { postUrl } from "@/util";
import type { Post } from "@/util";
import { format } from "date-fns";
export interface Props {
	post: Post;
	includeDescription?: boolean;
}

const { post, includeDescription = true } = Astro.props as Props;
const { title, description, pubDate } = post.data;
const datetime = pubDate.toISOString();
const postDate = format(pubDate, "MMM d, yyyy");
---

<a
	href={postUrl(post)}
	class="group -mx-4 block rounded-md px-4 py-4 transition-colors duration-200 hover:bg-surface-content/5"
>
	<div class="grid gap-y-1 sm:grid-cols-[7.5rem_1fr] sm:gap-x-6">
		<time
			datetime={datetime}
			class="pt-1 text-xs text-surface-content/55 tabular-nums"
		>
			{postDate}
		</time>
		<div>
			<h3
				class="text-lg leading-snug font-semibold transition-colors duration-200 group-hover:text-primary"
			>
				{title}
			</h3>
			{
				includeDescription && (
					<p class="mt-1 line-clamp-2 text-sm leading-relaxed text-surface-content/70">
						<span class="text-secondary/70">// </span>
						{description}
					</p>
				)
			}
		</div>
	</div>
</a>
