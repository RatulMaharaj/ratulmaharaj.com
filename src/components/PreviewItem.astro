---
import type { IElement } from "@/types";
import { postUrl } from "@/util";
import type { Post } from "@/util";
import { format } from "date-fns";
export interface Props extends IElement {
	post: Post;
	index: number;
	includeDescription?: boolean;
}

const { post, index, includeDescription = true } = Astro.props as Props;
const { pubDate } = post.data;
const date = new Date(pubDate);
const datetime = date.toISOString();
const postDate = format(date, "MMM d, yyyy");
const idx = String(index).padStart(2, "0");
---

<a
	href={postUrl(post)}
	class="group border-border grid grid-cols-[2.5rem_1fr] gap-x-5 border-t py-3.5 transition-colors duration-200 hover:bg-black/20 sm:grid-cols-[2.5rem_6.5rem_1fr]"
>
	<span
		class="pt-px text-xs font-light text-surface-content/30 tabular-nums"
		aria-hidden="true"
	>
		{idx}
	</span>
	<time
		datetime={datetime}
		class="col-start-2 pt-px text-xs text-surface-content/45 tabular-nums"
	>
		{postDate}
	</time>
	<div class="col-start-2 sm:col-start-3">
		<h3
			class="text-sm font-bold text-surface-content transition-colors duration-200 group-hover:text-primary"
		>
			{post.data.title}
		</h3>
		{
			includeDescription && (
				<p class="mt-1 text-[12.5px] text-surface-content/55">
					<span class="text-primary/70">// </span>
					{post.data.description}
				</p>
			)
		}
		{
			post.data.tags.length > 0 && (
				<div class="mt-1.5 flex flex-wrap gap-x-3 text-[11px] text-surface-content/35">
					{post.data.tags.map((tag) => (
						<span class="whitespace-nowrap">#{tag}</span>
					))}
				</div>
			)
		}
	</div>
</a>
