---
import type { IElement } from "@/types";
import { postUrl } from "@/util";
import type { Post } from "@/util";
import { format } from "date-fns";
export interface Props extends IElement {
	post: Post;
	includeDescription?: boolean;
}

const { post, includeDescription = true } = Astro.props as Props;
const { pubDate } = post.data;
const date = new Date(pubDate);
const datetime = date.toISOString();
const postDate = format(date, "yyyy-MM-dd");
---

<!-- A ledger row: the date in the machine voice, the title in the reading
     face. Hover lifts the ink; nothing else moves. -->
<a
	href={postUrl(post)}
	class="preview-row group grid gap-x-5 border-b py-3.5 sm:grid-cols-[6.5rem_1fr]"
	style="border-color: var(--rule)"
>
	<time
		datetime={datetime}
		class="pt-1 font-mono text-[10.5px] tracking-[0.04em] tabular-nums"
		style="color: var(--ink-3)"
	>
		{postDate}
	</time>
	<div>
		<h3
			class="preview-title mt-1 font-sans text-[15px] leading-snug font-semibold sm:mt-0"
		>
			{post.data.title}
		</h3>
		{
			includeDescription && (
				<p class="mt-0.5 font-sans text-[13px]" style="color: var(--ink-2)">
					{post.data.description}
				</p>
			)
		}
		{
			post.data.tags.length > 0 && (
				<div class="mt-1.5 flex flex-wrap gap-x-3">
					{post.data.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			)
		}
	</div>
</a>

<style>
	.preview-title {
		color: var(--ink);
		transition: color 120ms ease;
	}

	.preview-row:hover .preview-title {
		text-decoration: underline;
		text-decoration-color: var(--ink-3);
		text-underline-offset: 2px;
	}
</style>
