<canvas
	id="ascii-bg"
	class="pointer-events-none fixed inset-0 -z-10 h-full w-full"
	aria-hidden="true"></canvas>

<script>
	// ASCII noise field, drawn as a WebGL fragment shader. Composites over
	// the theme background with alpha so it works in both light and dark.
	const canvas = document.getElementById("ascii-bg") as HTMLCanvasElement;
	const gl = canvas?.getContext("webgl", {
		antialias: false,
		alpha: true,
		premultipliedAlpha: true,
	});

	if (canvas && gl) {
		const INTENSITY = 0.3;
		const CHARS = " .:-=+*#%@";

		const FRAG = `
			precision mediump float;
			uniform vec2 u_res;
			uniform float u_time;
			uniform vec2 u_mouse;
			uniform float u_light;
			uniform sampler2D u_atlas;
			uniform float u_cell;
			float hash21(vec2 p) {
				p = fract(p * vec2(123.34, 345.45));
				p += dot(p, p + 34.345);
				return fract(p.x * p.y);
			}
			float vnoise(vec2 p) {
				vec2 i = floor(p), f = fract(p);
				f = f * f * (3.0 - 2.0 * f);
				float a = hash21(i), b = hash21(i + vec2(1, 0));
				float c = hash21(i + vec2(0, 1)), d = hash21(i + vec2(1, 1));
				return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
			}
			float fbm(vec2 p) {
				float v = 0.0, a = 0.5;
				for (int i = 0; i < 4; i++) { v += a * vnoise(p); p *= 2.03; a *= 0.5; }
				return v;
			}
			vec3 rampDark(float t) {
				vec3 c = mix(vec3(0.25, 0.21, 0.45), vec3(0.36, 0.30, 0.75), smoothstep(0.0, 0.45, t));
				c = mix(c, vec3(0.66, 0.42, 0.97), smoothstep(0.45, 0.8, t));
				c = mix(c, vec3(0.85, 0.78, 1.0), smoothstep(0.8, 1.0, t));
				return c;
			}
			vec3 rampLight(float t) {
				vec3 c = mix(vec3(0.80, 0.78, 0.92), vec3(0.62, 0.55, 0.88), smoothstep(0.0, 0.45, t));
				c = mix(c, vec3(0.55, 0.33, 0.85), smoothstep(0.45, 0.8, t));
				c = mix(c, vec3(0.30, 0.20, 0.60), smoothstep(0.8, 1.0, t));
				return c;
			}
			void main() {
				vec2 fc = gl_FragCoord.xy;
				vec2 cell = floor(fc / u_cell);
				vec2 cuv = fract(fc / u_cell);
				vec2 cp = (cell * u_cell + 0.5 * u_cell - 0.5 * u_res) / u_res.y;
				float t = u_time * 0.25;
				float n = fbm(cp * 2.2 + vec2(t * 0.6, t * 0.25));
				vec2 mp = (u_mouse * u_res - 0.5 * u_res) / u_res.y;
				n += 0.35 * exp(-length(cp - mp) * 4.0);
				n = clamp(n, 0.0, 0.999);
				float idx = floor(n * 10.0);
				float g = texture2D(u_atlas, vec2((idx + cuv.x) / 10.0, cuv.y)).r;
				vec3 col = mix(rampDark(n), rampLight(n), u_light);
				float a = g * ${INTENSITY} * (0.25 + 0.75 * n);
				gl_FragColor = vec4(col * a, a);
			}
		`;

		const compile = (type: number, src: string) => {
			const s = gl.createShader(type)!;
			gl.shaderSource(s, src);
			gl.compileShader(s);
			return s;
		};
		const prog = gl.createProgram()!;
		gl.attachShader(
			prog,
			compile(
				gl.VERTEX_SHADER,
				"attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}",
			),
		);
		gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
		gl.linkProgram(prog);
		if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
			canvas.remove();
		} else {
			gl.useProgram(prog);
			const u = (n: string) => gl.getUniformLocation(prog, n);

			const buf = gl.createBuffer();
			gl.bindBuffer(gl.ARRAY_BUFFER, buf);
			gl.bufferData(
				gl.ARRAY_BUFFER,
				new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
				gl.STATIC_DRAW,
			);
			const loc = gl.getAttribLocation(prog, "a");
			gl.enableVertexAttribArray(loc);
			gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

			// Glyph atlas: the charset ramped by ink density
			const ac = document.createElement("canvas");
			ac.width = 320;
			ac.height = 32;
			const actx = ac.getContext("2d")!;
			actx.fillStyle = "#000";
			actx.fillRect(0, 0, 320, 32);
			actx.fillStyle = "#fff";
			actx.font = "bold 24px ui-monospace, Menlo, Consolas, monospace";
			actx.textAlign = "center";
			actx.textBaseline = "middle";
			for (let i = 0; i < CHARS.length; i++)
				actx.fillText(CHARS[i], i * 32 + 16, 17);
			const tex = gl.createTexture();
			gl.bindTexture(gl.TEXTURE_2D, tex);
			gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
			gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, ac);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
			gl.uniform1i(u("u_atlas"), 0);

			const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
			const reduced = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			let time = reduced ? 37 : 0;
			let last = performance.now();
			let mouse = [0.5, 0.5];
			const smooth = [0.5, 0.5];
			let raf = 0;

			const isDark = () => document.documentElement.classList.contains("dark");

			const drawFrame = () => {
				gl.uniform2f(u("u_res"), canvas.width, canvas.height);
				gl.uniform1f(u("u_time"), time);
				gl.uniform2f(u("u_mouse"), smooth[0], smooth[1]);
				gl.uniform1f(u("u_light"), isDark() ? 0 : 1);
				gl.uniform1f(u("u_cell"), 14 * dpr);
				gl.clearColor(0, 0, 0, 0);
				gl.clear(gl.COLOR_BUFFER_BIT);
				gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
			};

			const resize = () => {
				canvas.width = Math.round(window.innerWidth * dpr);
				canvas.height = Math.round(window.innerHeight * dpr);
				gl.viewport(0, 0, canvas.width, canvas.height);
				if (reduced) drawFrame();
			};
			window.addEventListener("resize", resize);
			resize();

			if (reduced) {
				// A single still frame; re-drawn only on resize or theme change
				drawFrame();
				new MutationObserver(drawFrame).observe(document.documentElement, {
					attributes: true,
					attributeFilter: ["class"],
				});
			} else {
				window.addEventListener("pointermove", (e) => {
					mouse = [
						e.clientX / window.innerWidth,
						1 - e.clientY / window.innerHeight,
					];
				});
				const loop = (now: number) => {
					time += Math.min((now - last) / 1000, 0.1);
					last = now;
					smooth[0] += (mouse[0] - smooth[0]) * 0.06;
					smooth[1] += (mouse[1] - smooth[1]) * 0.06;
					drawFrame();
					raf = requestAnimationFrame(loop);
				};
				raf = requestAnimationFrame(loop);
				document.addEventListener("visibilitychange", () => {
					if (document.hidden) {
						cancelAnimationFrame(raf);
					} else {
						last = performance.now();
						raf = requestAnimationFrame(loop);
					}
				});
			}
		}
	}
</script>
