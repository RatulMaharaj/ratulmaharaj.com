---
import { tagUrl } from "@/util";
export interface Props {
	allTags: string[];
}
const { allTags } = Astro.props as Props;
---

<aside>
	<h2 class="section-label mb-4">Tags</h2>
	<ul class="flex flex-wrap gap-x-4 gap-y-2">
		{
			allTags.map((tag) => (
				<li>
					<a
						class="tag"
						href={tagUrl(tag)}
						aria-label={`View all posts with the tag: ${tag}`}
					>
						#{tag}
					</a>
				</li>
			))
		}
	</ul>
	<a
		class="mt-4 inline-block text-xs text-surface-content/55 transition-colors duration-200 hover:text-primary"
		href="/tags"
		aria-label="View all blog categories"
	>
		View all &rarr;
	</a>
</aside>
