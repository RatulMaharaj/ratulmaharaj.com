---
import { execSync } from "node:child_process";
import SocialList from "./SocialList.astro";

const year = new Date().getFullYear();

// Resolved once at build time (static output). Vercel exposes the SHA as
// an env var; local builds fall back to git.
let commitHash = process.env.VERCEL_GIT_COMMIT_SHA?.slice(0, 7);
if (!commitHash) {
	try {
		commitHash = execSync("git rev-parse --short HEAD").toString().trim();
	} catch {
		commitHash = undefined;
	}
}
---

<!-- The status bar: ledger voice above a hairline rule. -->
<footer class="mt-20 border-t pt-5 pb-10" style="border-color: var(--rule)">
	<div class="grid grid-cols-1 gap-y-4 sm:grid-cols-2 sm:place-content-center">
		<div
			class="flex items-center justify-start font-mono text-[10px] tracking-[0.13em] uppercase"
			style="color: var(--ink-3)"
		>
			&copy; Ratul Maharaj {year}
		</div>
		<div class="flex items-center justify-start sm:justify-end">
			<SocialList />
		</div>
	</div>
	<div
		class="mt-4 font-mono text-[10px] tracking-[0.13em] uppercase"
		style="color: var(--ink-3)"
	>
		{
			commitHash && (
				<>
					<a
						class="ledger-link"
						href={`https://github.com/RatulMaharaj/ratulmaharaj.com/commit/${commitHash}`}
					>
						{commitHash}
					</a>
				</>
			)
		}
	</div>
</footer>
