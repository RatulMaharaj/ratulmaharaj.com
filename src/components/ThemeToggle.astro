<script>
	declare global {
		interface Window {
			__applyTheme?: (theme: string, persist?: boolean) => void;
		}
	}

	// Cycles the three papers: day → sepia → night. The heavy lifting
	// (classes, meta tag, storage, the themechange event) lives in the inline
	// script in Base.astro as window.__applyTheme.
	const order = ["day", "sepia", "night"] as const;
	const root = document.documentElement;
	const button = document.getElementById("toggle-theme");
	const label = document.getElementById("toggle-theme-label");

	const current = () => (root.dataset.theme as (typeof order)[number]) ?? "day";

	const render = () => {
		if (label) label.textContent = current();
	};
	render();
	document.addEventListener("themechange", render);

	// Follow OS changes only until the reader has chosen a paper themselves.
	window
		.matchMedia("(prefers-color-scheme: dark)")
		.addEventListener("change", (event) => {
			if (localStorage.getItem("theme")) return;
			window.__applyTheme?.(event.matches ? "night" : "day", false);
		});

	button?.addEventListener("click", () => {
		const next = order[(order.indexOf(current()) + 1) % order.length];
		window.__applyTheme?.(next);
	});
</script>

<button
	type="button"
	id="toggle-theme"
	aria-label="Switch theme"
	class="rail-btn"
>
	<span id="toggle-theme-label">day</span>
</button>
