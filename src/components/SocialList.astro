---
interface Props {
	rss?: boolean;
	github?: boolean;
}

const { rss = true, github = true } = Astro.props;

type SocialLink = { href: string; label: string; rel?: string };

const links: SocialLink[] = [
	...(github
		? [
				{
					href: "https://github.com/RatulMaharaj",
					label: "github",
					rel: "noopener noreferrer",
				},
			]
		: []),
	{ href: "https://x.com/ratulmaharaj", label: "x", rel: "me" },
	{
		href: "https://linkedin.com/in/ratulmaharaj",
		label: "linkedin",
		rel: "noopener noreferrer",
	},
	{
		href: "https://youtube.com/@RatulMaharaj",
		label: "youtube",
		rel: "noopener noreferrer",
	},
	...(rss ? [{ href: "/rss.xml", label: "rss" }] : []),
	{
		href: "https://cal.com/ratulmaharaj?redirect=false",
		label: "cal.com",
		rel: "noopener noreferrer",
	},
];
---

<ul class="m-0 flex list-none flex-wrap items-center gap-x-3 p-0 text-xs">
	{
		links.map(({ href, label, rel }) => (
			<li>
				<a
					class="text-surface-content/55 underline-offset-2 transition-colors duration-200 hover:text-primary hover:underline"
					href={href}
					target={href.startsWith("/") ? undefined : "_blank"}
					rel={rel}
				>
					{label}
				</a>
			</li>
		))
	}
</ul>
