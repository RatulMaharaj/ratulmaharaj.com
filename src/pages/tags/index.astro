---
import PageLayout from "@/layouts/Base";
import { getCollection } from "astro:content";
import { getAllTagsWithCount, tagUrl } from "@/util";

const allPosts = await getCollection("posts");
const allPostTags = getAllTagsWithCount(allPosts);
const sortedTags = Object.entries(allPostTags).sort(
	([, a], [, b]) => b - a,
);

const meta = {
	title: "Tags",
	description: "All tags from my blog posts.",
};
---

<PageLayout meta={meta}>
	<h1 class="mb-8 text-2xl font-bold tracking-tight">
		<span class="text-secondary">// </span>tags
	</h1>
	<ul class="flex max-w-2xl flex-wrap gap-x-6 gap-y-3">
		{
			sortedTags.map(([tag, count]) => (
				<li>
					<a
						class="tag text-sm"
						href={tagUrl(tag)}
						title={`View posts with the tag: ${tag}`}
					>
						#{tag}
						<span class="text-surface-content/40">({count})</span>
					</a>
				</li>
			))
		}
	</ul>
</PageLayout>
