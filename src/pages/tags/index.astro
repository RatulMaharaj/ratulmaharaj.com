---
import PageLayout from "@/layouts/Base";
import { getCollection } from "astro:content";
import { getAllTagsWithCount, tagUrl } from "@/util";

const allPosts = await getCollection("posts");
const allPostTags = getAllTagsWithCount(allPosts);
const sortedTags = Object.entries(allPostTags).sort(
	([a, countA], [b, countB]) => countB - countA || a.localeCompare(b),
);

const meta = {
	title: "Tags",
	description: "All tags from my blog posts and snippets.",
};
---

<PageLayout meta={meta}>
	<h1 class="section-label pb-3">
		Tags{" "}
		<span class="text-surface-content/30">
			({String(sortedTags.length).padStart(3, "0")})
		</span>
	</h1>
	<ul
		class="flex max-w-2xl flex-wrap gap-x-4 gap-y-2 border-t-[0.5px] border-border pt-4"
	>
		{
			sortedTags.map(([tag, count]) => (
				<li>
					<a
						class="tag"
						href={tagUrl(tag)}
						title={`View posts with the tag: ${tag}`}
					>
						#{tag} <span class="text-surface-content/25">({count})</span>
					</a>
				</li>
			))
		}
	</ul>
</PageLayout>
