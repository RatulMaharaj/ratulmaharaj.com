---
import { getCollection } from "astro:content";
import PreviewItem from "@/components/PreviewItem";
import Paginator from "@/components/Paginator";
import PageLayout from "@/layouts/Base";
import type { Page } from "@/types";
import type { PaginateFunction } from "astro";
import { getAllTags, sortPostsByDate } from "@/util";
import type { Post } from "@/util";

export async function getStaticPaths({
	paginate,
}: {
	paginate: PaginateFunction;
}) {
	const allPosts = await getCollection("posts");
	const allPostsByDate = sortPostsByDate(allPosts);
	const allTags = getAllTags(allPostsByDate);

	return allTags.flatMap((tag) => {
		const filterItems = allPostsByDate.filter((item) =>
			item.data.tags?.some((t) => t.toLowerCase() === tag),
		);
		return paginate(filterItems, {
			params: { tag },
			pageSize: 10,
		});
	});
}

export interface Props {
	page: Page<Post>;
}

const { page } = Astro.props as Props;

const { tag } = Astro.params;

const paginationProps = {
	...(page.url.prev && {
		prevUrl: { url: page.url.prev, text: `← Previous Posts` },
	}),
	...(page.url.next && {
		nextUrl: { url: page.url.next, text: `Next Posts →` },
	}),
};
const meta = {
	title: `Tag: ${tag}`,
	description: `View all posts and snippets tagged with ${tag}.`,
};
---

<PageLayout meta={meta}>
	<section aria-label="Blog post list">
		<h1 class="section-label pb-3">
			Posts tagged <span class="normal-case">#{tag}</span>{" "}
			<span class="text-surface-content/30">
				({String(page.total).padStart(3, "0")})
			</span>
		</h1>
		{
			page.data.length > 0 && (
				<ul class="border-b-[0.5px] border-border">
					{page.data.map((p) => (
						<li>
							<PreviewItem post={p} />
						</li>
					))}
				</ul>
			)
		}
		<Paginator {...paginationProps} />
	</section>
</PageLayout>
