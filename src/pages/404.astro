---
import PageLayout from "@/layouts/Base";

const meta = {
	title: "404: Page not found",
	description: "The page you are looking for does not exist.",
};
---

<PageLayout meta={meta}>
	<h1 class="mb-6 font-sans text-lg font-semibold">
		404: no such file or directory
	</h1>
	<p class="mb-8 font-sans text-[15px]" style="color: var(--ink-2)">
		The page you're looking for doesn't exist, was moved, or never got written.
	</p>
	<a href="/" class="ledger-link">$ cd ~</a>
</PageLayout>
