---
import PageLayout from "@/layouts/Base";

const meta = {
	title: "Oops! You found a missing page!",
	description: "Oops! It looks like this page is lost in space!",
};
---

<PageLayout meta={meta}>
	<h1 class="mb-8 text-2xl font-bold tracking-tight">
		<span class="text-secondary">// </span>404 — page not found
	</h1>
	<p class="text-sm leading-relaxed text-surface-content/70">
		This page doesn't exist (or it moved). Head back
		<a
			href="/"
			class="text-primary underline decoration-primary/40 underline-offset-2 transition-colors duration-200 hover:decoration-primary"
			>home</a
		> or browse the
		<a
			href="/posts"
			class="text-primary underline decoration-primary/40 underline-offset-2 transition-colors duration-200 hover:decoration-primary"
			>posts</a
		>.
	</p>
</PageLayout>
