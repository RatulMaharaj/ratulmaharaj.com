---
import { getCollection } from "astro:content";
import PreviewItem from "@/components/PreviewItem";
import Pagination from "@/components/Paginator";
import PageLayout from "@/layouts/Base";
import type { Page } from "@/types";
import type { PaginateFunction } from "astro";
import { getAllTags, sortPostsByDate } from "src/util";
import type { Post } from "src/util";
import Tags from "@/components/Tags";

export async function getStaticPaths({
	paginate,
}: {
	paginate: PaginateFunction;
}) {
	const allPosts = await getCollection("posts");
	const allPostsByDate = sortPostsByDate(allPosts);
	const allTags = getAllTags(allPosts);
	return paginate(allPostsByDate, { props: { allTags }, pageSize: 10 });
}

export interface Props {
	page: Page<Post>;
	allTags: string[];
}

const { page, allTags } = Astro.props as Props;

const meta = {
	title: "Posts",
	description: "A collection of blog posts I've written.",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			url: page.url.prev,
			text: `← Previous Posts`,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			url: page.url.next,
			text: `Next Posts →`,
		},
	}),
};
---

<PageLayout meta={meta}>
	<div class="grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8">
		<section aria-label="Blog post list">
			<h1 class="section-label pb-3">
				Posts{" "}
				<span class="text-surface-content/30">
					({String(page.total).padStart(3, "0")})
				</span>
			</h1>
			<ul class="border-border border-b">
				{
					page.data.map((p, i) => (
						<li>
							<PreviewItem post={p} index={page.start + i + 1} />
						</li>
					))
				}
			</ul>
			<Pagination {...paginationProps} />
		</section>
		<Tags allTags={allTags} />
	</div>
</PageLayout>
