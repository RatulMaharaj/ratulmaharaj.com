---
import { getCollection, render } from "astro:content";
import BlogPost from "@/layouts/BlogPost";
import { getPreviousAndNextPosts, sortPostsByDate } from "@/util";
import type { Post } from "@/util";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

export interface Props {
	post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const sortedPosts = sortPostsByDate(await getCollection("posts"));
const { prev, next } = getPreviousAndNextPosts(post.id, sortedPosts);
---

<BlogPost post={post} headings={headings} prev={prev} next={next}>
	<Content />
</BlogPost>
