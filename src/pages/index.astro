---
import Bio from "@/components/Bio";
import PreviewItem from "@/components/PreviewItem";
import SocialList from "@/components/SocialList";
import PageLayout from "@/layouts/Base";
import { getCollection } from "astro:content";
import { sortPostsByDate } from "@/util";

const meta = {
	title: "Home",
	description:
		"Hi there! I'm Ratul Maharaj, and this is my little corner of the internet where I share my thoughts and experiences with programming.",
};

const MAX_POSTS = 10;
const allPosts = await getCollection("posts");
const allPostsByDate = sortPostsByDate(allPosts).slice(0, MAX_POSTS);
---

<PageLayout meta={meta}>
	<section class="grid grid-cols-1 gap-y-8">
		<Bio />
		<div class="flex gap-x-4">
			<p>Find me on:</p>
			<SocialList />
		</div>
	</section>
	<section aria-label="Blog post list" class="mt-16">
		<h2 class="section-label pb-3">
			Recent Posts{" "}
			<span class="text-surface-content/30">
				({String(allPostsByDate.length).padStart(3, "0")})
			</span>
		</h2>
		<ul class="border-border border-b">
			{
				allPostsByDate.map((p) => (
					<li>
						<PreviewItem post={p} />
					</li>
				))
			}
		</ul>
		<a
			href="/posts"
			class="mt-5 inline-block text-xs text-surface-content/55 transition-colors duration-200 hover:text-primary"
			>see all posts &rarr;</a
		>
	</section>
</PageLayout>
