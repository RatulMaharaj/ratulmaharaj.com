---
import Bio from "@/components/Bio";
import PreviewItem from "@/components/PreviewItem";
import SocialList from "@/components/SocialList";
import PageLayout from "@/layouts/Base";
import { getCollection } from "astro:content";
import { sortPostsByDate } from "@/util";

const meta = {
	title: "Home",
	description:
		"Hi there! I'm Ratul Maharaj, and this is my little corner of the internet where I share my thoughts and experiences with programming.",
};

const MAX_POSTS = 10;
const allPosts = await getCollection("posts");
const allPostsByDate = sortPostsByDate(allPosts).slice(0, MAX_POSTS);
---

<PageLayout meta={meta}>
	<section class="relative grid grid-cols-1 gap-y-8">
		<div aria-hidden="true" class="hero-glow"></div>
		<Bio />
		<div class="flex items-center gap-x-4">
			<p class="text-sm text-surface-content/70">Find me on:</p>
			<SocialList />
		</div>
	</section>
	<section aria-label="Blog post list" class="mt-16">
		<h2 class="section-label mb-4">Recent posts</h2>
		<ul class="space-y-1">
			{
				allPostsByDate.map((p) => (
					<li>
						<PreviewItem post={p} />
					</li>
				))
			}
		</ul>
		<a
			href="/posts"
			class="mt-6 inline-block text-sm text-surface-content/70 transition-colors duration-200 hover:text-primary"
			>See all posts &rarr;</a
		>
	</section>
</PageLayout>
